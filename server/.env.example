# Copy to .env and fill in. Every value is validated on boot in configs/env.ts,
# so a missing or malformed one stops the process with an explicit message.

# Required
DATABASE_URL="file:./dev.db"

# Required, at least 32 characters. Generate one with: openssl rand -hex 32
# Changing it invalidates every access token already handed out
JWT_ACCESS_SECRET=

# Optional, shown with their defaults
PORT=3001
CLIENT_URL=http://localhost:8080
NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
